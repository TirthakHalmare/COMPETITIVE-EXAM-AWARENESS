rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: check if current user matches document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function: check if user has admin role
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Competitive Exams collection
    // Publicly readable so students can explore without requiring an account
    match /exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Seminars and Online Sessions
    // Publicly readable so students can browse seminars
    match /seminars/{seminarId} {
      allow read: if true;
      // Admins can create, edit, delete. Users can decrement seats when registering via transaction.
      allow write: if isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount', 'availableSeats']));
    }

    // Registrations collection
    match /registrations/{regId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Study Tasks / Planner
    match /study_tasks/{taskId} {
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Saved Items / Bookmarks
    match /saved_items/{saveId} {
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Notifications & Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.isGlobal == true);
      allow write: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}
